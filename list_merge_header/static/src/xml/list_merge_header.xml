<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="list_merge_header.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//thead" position="before">
            <colgroup t-if="this.hasMergeHeaders" class="o_merge_column_widths">
                <col t-foreach="this.mergeWidthColumns" t-as="index" t-key="index"/>
            </colgroup>
        </xpath>
        <xpath expr="//thead/tr" position="before">
            <tr t-if="this.hasMergeHeaders" class="o_merge_header_top">
                <td t-if="this.hasSelectors" aria-hidden="true" class="o_list_record_selector"/>
                <td t-foreach="this.getMergeGroups()" t-as="group" t-key="group.id"
                    t-att-colspan="group.span" t-att-role="group.mergeId ? 'columnheader' : undefined"
                    t-att-scope="group.mergeId ? 'colgroup' : undefined"
                    t-att-aria-hidden="group.mergeId ? undefined : 'true'"
                    t-att-class="{'o_merge_group_header': group.mergeId}" class="align-middle text-center">
                    <span t-out="group.label"/>
                </td>
                <td t-if="this.hasOpenFormViewColumn" aria-hidden="true" class="w-print-0 p-print-0"/>
                <td t-if="this.hasActionsColumn" aria-hidden="true" class="w-print-0 p-print-0"/>
            </tr>
        </xpath>
    </t>
</templates>
