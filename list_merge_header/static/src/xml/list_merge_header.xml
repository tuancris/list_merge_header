<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ═══════════════════════════════════════════════════════════════
         Shared sub-template: a single column header <th>.
         Expects variables in calling scope:
           • column  (Column object)   – required
           • _rs     (rowspan integer)  – optional, omitted when unset
    ═══════════════════════════════════════════════════════════════════ -->
    <t t-name="list_merge_header.ColumnTh">
        <th t-if="column.type === 'field'"
            t-att-data-name="column.name"
            t-att-class="getColumnClass(column) + ' opacity-trigger-hover w-print-auto'"
            t-att-rowspan="_rs"
            t-on-pointerup="onColumnTitleMouseUp"
            t-on-click="() => this.onClickSortColumn(column)"
            t-on-keydown="(ev) => this.onCellKeydown(ev)"
            data-tooltip-delay="1000"
            tabindex="-1">
            <t t-if="column.hasLabel and column.widget !== 'handle'">
                <t t-set="isNumeric" t-value="isNumericColumn(column)"/>
                <div class="d-flex align-items-center"
                     t-att-data-tooltip-template="isDebugMode ? 'web.FieldTooltip' : 'web.ListHeaderTooltip'"
                     t-att-data-tooltip-info="makeTooltip(column)">
                    <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1"
                          t-att-class="isNumeric ? 'o_list_number_th' : ''"
                          t-esc="column.label"/>
                    <div class="o_list_header_label_spacer"/>
                    <i class="o_list_sortable_icon" t-att-class="getSortableIconClass(column)"/>
                </div>
                <span class="o_resize position-absolute top-0 end-0 bottom-0 ps-1 bg-black-25 opacity-0 opacity-50-hover z-1"
                      t-on-pointerdown.stop.prevent="this.columnWidths.onStartResize"
                      t-on-dblclick="this.columnWidths.resetWidths"/>
            </t>
        </th>
        <th t-else=""
            t-att-rowspan="_rs"
            t-on-keydown="(ev) => this.onCellKeydown(ev)"
            t-att-class="{'o_list_button w-print-0 p-print-0': column.type === 'button_group'}"/>
    </t>

    <!-- ═══════════════════════════════════════════════════════════════
         Shared sub-template: actions column header (optional fields
         dropdown).
         Expects: _rs (optional rowspan)
    ═══════════════════════════════════════════════════════════════════ -->
    <t t-name="list_merge_header.ActionsHeader">
        <th t-if="hasActionsColumn"
            t-att-rowspan="_rs"
            t-on-keydown="(ev) => this.onCellKeydown(ev)"
            class="o_list_controller o_list_actions_header w-print-0 p-print-0 position-sticky end-0">
            <div t-if="displayOptionalFields or hasOptionalOpenFormViewColumn"
                 class="o_optional_columns_dropdown d-print-none text-center border-top-0">
                <Dropdown position="'bottom-end'">
                    <button class="btn p-0" tabindex="-1">
                        <i class="o_optional_columns_dropdown_toggle oi oi-fw oi-settings-adjust"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="optionalFieldGroups" t-as="group" t-key="group_index">
                            <div t-if="!group_first" role="separator" class="dropdown-divider"/>
                            <DropdownItem t-if="group.displayName" closingMode="'none'"
                                          onSelected="() => this.toggleOptionalFieldGroup(group.id)">
                                <div class="fw-bold" t-esc="group.displayName"/>
                            </DropdownItem>
                            <t t-foreach="group.optionalFields" t-as="field" t-key="field_index">
                                <DropdownItem closingMode="'none'"
                                              onSelected="() => this.toggleOptionalField(field.name)">
                                    <CheckBox
                                        onChange="() => this.toggleOptionalField(field.name)"
                                        value="field.value"
                                        name="field.name">
                                        <span class="d-flex align-items-center"><span class="text-truncate" t-esc="field.label"/><span class="ps-1" t-if="env.debug" t-esc="' (' + field.name + ')'" /></span>
                                    </CheckBox>
                                </DropdownItem>
                            </t>
                        </t>
                        <div t-if="hasOptionalOpenFormViewColumn" role="separator" class="dropdown-divider"/>
                        <DropdownItem t-if="hasOptionalOpenFormViewColumn" closingMode="'none'"
                                      onSelected="() => this.toggleDebugOpenView()">
                            <CheckBox
                                onChange="() => this.toggleDebugOpenView()"
                                value="this.debugOpenView"
                                name="'View Button'">
                                <span class="d-flex align-items-center"><span class="text-truncate">View Button</span></span>
                            </CheckBox>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </th>
    </t>

    <!-- ═══════════════════════════════════════════════════════════════
         Extension: replace <thead> in web.ListRenderer with a
         merge-aware version.

         • When NO <merge> groups exist → renders the original single-
           row header (identical to stock Odoo).
         • When <merge> groups exist → renders a two-row header:
             Row 1: group labels (colspan) + non-merged columns
                    (rowspan=2)
             Row 2: individual field headers for merged columns
    ═══════════════════════════════════════════════════════════════════ -->
    <t t-name="list_merge_header.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//thead" position="replace">
            <thead>
                <!-- ─── MERGE MODE: two-row header ─────────────── -->
                <t t-if="hasMergeHeaders">
                    <!-- Row 1 – group labels + non-merged (rowspan=2) -->
                    <tr class="o_merge_header_top">
                        <th t-if="hasSelectors" rowspan="2"
                            class="o_list_record_selector o_list_controller align-middle pe-1 cursor-pointer"
                            tabindex="-1"
                            t-on-keydown="(ev) => this.onCellKeydown(ev)"
                            t-on-click.stop="toggleSelection">
                            <CheckBox disabled="!_canSelectRecord" value="selectAll"
                                      className="'d-flex m-0'" onChange.bind="toggleSelection"/>
                        </th>
                        <t t-foreach="getMergeGroups()" t-as="mg" t-key="mg.id">
                            <!-- non-merged column: full header + rowspan=2 -->
                            <t t-if="!mg.isMerge">
                                <t t-call="list_merge_header.ColumnTh">
                                    <t t-set="column" t-value="mg.column"/>
                                    <t t-set="_rs" t-value="2"/>
                                </t>
                            </t>
                            <!-- merged group: group label + colspan -->
                            <th t-else=""
                                t-att-colspan="mg.span"
                                class="text-center o_merge_group_header align-middle">
                                <span t-esc="mg.label"/>
                            </th>
                        </t>
                        <th t-if="hasOpenFormViewColumn" rowspan="2"
                            t-on-keydown="(ev) => this.onCellKeydown(ev)"
                            class="o_list_open_form_view w-print-0 p-print-0"/>
                        <t t-call="list_merge_header.ActionsHeader">
                            <t t-set="_rs" t-value="2"/>
                        </t>
                    </tr>
                    <!-- Row 2 – sub-headers (merged columns only) -->
                    <tr class="o_merge_header_sub">
                        <t t-foreach="mergeSubColumns" t-as="column" t-key="column.id">
                            <t t-call="list_merge_header.ColumnTh"/>
                        </t>
                    </tr>
                </t>
                <!-- ─── NORMAL MODE: original single-row header ── -->
                <t t-else="">
                    <tr>
                        <th t-if="hasSelectors"
                            class="o_list_record_selector o_list_controller align-middle pe-1 cursor-pointer"
                            tabindex="-1"
                            t-on-keydown="(ev) => this.onCellKeydown(ev)"
                            t-on-click.stop="toggleSelection">
                            <CheckBox disabled="!_canSelectRecord" value="selectAll"
                                      className="'d-flex m-0'" onChange.bind="toggleSelection"/>
                        </th>
                        <t t-foreach="columns" t-as="column" t-key="column.id">
                            <t t-call="list_merge_header.ColumnTh"/>
                        </t>
                        <th t-if="hasOpenFormViewColumn"
                            t-on-keydown="(ev) => this.onCellKeydown(ev)"
                            class="o_list_open_form_view w-print-0 p-print-0"/>
                        <t t-call="list_merge_header.ActionsHeader"/>
                    </tr>
                </t>
            </thead>
        </xpath>
    </t>

</templates>
